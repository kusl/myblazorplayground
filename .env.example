# Copied to .env by scripts/instance.sh and scripts/dev.sh on first run, with a random POSTGRES_PASSWORD.
# Every variable is assigned (even when empty) because some podman-compose versions ignore ${VAR:-default}.

POSTGRES_USER=playground
POSTGRES_PASSWORD=change-me
POSTGRES_DB=playground

# Host ports, bound to 127.0.0.1 only. MyRestaurant uses 8080, 8443 and 5432, so these differ.
PLAYGROUND_WEB_PORT=8090
PLAYGROUND_DB_PORT=5433

SITE_NAME=my blazor playground
SITE_TIME_ZONE=America/New_York
SITE_SOURCE_URL=https://github.com/kusl/myblazorplayground

# Cloudflare limits a single upload to 100 MB on the free plan, so the default stays just under it.
WORK_MAX_ATTACHMENT_BYTES=99614720

SOURCE_REVISION=
