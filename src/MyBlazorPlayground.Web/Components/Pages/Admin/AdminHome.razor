@page "/admin"
@attribute [Authorize(Policy = IdentityRegistration.AdministratorPolicy)]
@using MyBlazorPlayground.Data.People
@using MyBlazorPlayground.Data.Settings
@using MyBlazorPlayground.Data.Audit
@using MyBlazorPlayground.Web.Administration
@inject PersonStore People
@inject SiteSettings Settings
@inject AuditLog Audit
@inject LocalTime Clock
@inject TwoFactorService TwoFactor

<PageTitle>Administration</PageTitle>

<h1>Administration</h1>
<AdminTabs />

<Notice Text="@_message" Error="@_error" />

<section class="panel">
    <h2>Registration</h2>
    <p>Anyone can create an account: <strong>@(_registrationOpen ? "yes" : "no")</strong>. Accounts only matter for the project tracker. Homes and the shared toys need none.</p>
    <form method="post" @formname="registration" @onsubmit="ToggleRegistrationAsync" data-enhance>
        <AntiforgeryToken />
        <button type="submit" class="secondary">@(_registrationOpen ? "Close registration" : "Open registration")</button>
    </form>
</section>

<h2>People (@_people.Count)</h2>
<div class="table-scroll">
    <table class="stack">
        <thead>
            <tr><th>User</th><th>Role</th><th>Last sign in</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var person in _people)
            {
                var id = person.Id;
                <tr>
                    <td data-label="User">
                        <strong>@person.DisplayName</strong><br />
                        <span class="muted">@person.UserName</span>
                        @if (person.DisabledAt is not null)
                        {
                            <span class="badge">disabled</span>
                        }
                        @if (person.HasTwoFactor)
                        {
                            <span class="badge">two-step</span>
                        }
                    </td>
                    <td data-label="Role">@(person.IsAdministrator ? "Administrator" : "Member")</td>
                    <td data-label="Last sign in">@(person.LastSignInAt is { } at ? Clock.Format(at) : "never")</td>
                    <td class="cell-actions">
                        <div class="actions">
                            <form method="post" @formname="@($"admin-{id:N}")" @onsubmit="() => ToggleAdministratorAsync(person)" data-enhance class="inline-form">
                                <AntiforgeryToken />
                                <button type="submit" class="small secondary">@(person.IsAdministrator ? "Remove administrator" : "Make administrator")</button>
                            </form>
                            <form method="post" @formname="@($"disable-{id:N}")" @onsubmit="() => ToggleDisabledAsync(person)" data-enhance class="inline-form">
                                <AntiforgeryToken />
                                <button type="submit" class="small @(person.DisabledAt is null ? "danger" : "secondary")">@(person.DisabledAt is null ? "Disable" : "Enable")</button>
                            </form>
                            @if (person.HasTwoFactor)
                            {
                                <form method="post" @formname="@($"two-step-{id:N}")" @onsubmit="() => ResetTwoFactorAsync(person)" data-enhance class="inline-form">
                                    <AntiforgeryToken />
                                    <button type="submit" class="small secondary">Turn off two-step</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private IReadOnlyList<PersonRecord> _people = [];
    private bool _registrationOpen;
    private string? _message;
    private bool _error;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private Actor Actor => HttpContext.User.ToActor()!;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _people = await People.ListAsync(HttpContext.RequestAborted);
        _registrationOpen = await Settings.GetFlagAsync(SiteSettings.RegistrationOpen, true, HttpContext.RequestAborted);
    }

    private async Task ToggleRegistrationAsync()
    {
        var open = !_registrationOpen;
        await Settings.SetAsync(SiteSettings.RegistrationOpen, open ? "true" : "false", HttpContext.RequestAborted);
        await Audit.WriteAsync(Audits.For(Actor, open ? "registration-opened" : "registration-closed", "setting", SiteSettings.RegistrationOpen, open ? "Opened registration" : "Closed registration"), HttpContext.RequestAborted);
        Say(open ? "Registration is open." : "Registration is closed.", false);
        await LoadAsync();
    }

    private async Task ToggleAdministratorAsync(PersonRecord person)
    {
        var grant = !person.IsAdministrator;
        if (await People.SetAdministratorAsync(person.Id, grant, Actor.PersonId, HttpContext.RequestAborted))
        {
            await Audit.WriteAsync(Audits.For(Actor, grant ? "role-granted" : "role-revoked", "person", person.Id.ToString(), $"{person.UserName} {(grant ? "is now" : "is no longer")} an administrator"), HttpContext.RequestAborted);
            Say(grant ? $"{person.UserName} is now an administrator." : $"{person.UserName} is no longer an administrator.", false);
        }
        else
        {
            Say(grant ? "Nothing changed." : "The site needs at least one active administrator.", true);
        }

        await LoadAsync();
    }

    private async Task ToggleDisabledAsync(PersonRecord person)
    {
        var disable = person.DisabledAt is null;
        if (await People.SetDisabledAsync(person.Id, disable, HttpContext.RequestAborted))
        {
            await Audit.WriteAsync(Audits.For(Actor, disable ? "account-disabled" : "account-enabled", "person", person.Id.ToString(), $"{person.UserName} {(disable ? "disabled" : "enabled")}"), HttpContext.RequestAborted);
            Say(disable ? $"{person.UserName} is disabled and signed out." : $"{person.UserName} can sign in again.", false);
        }
        else
        {
            Say(disable ? "The last active administrator cannot be disabled." : "Nothing changed.", true);
        }

        await LoadAsync();
    }

    private async Task ResetTwoFactorAsync(PersonRecord person)
    {
        Say(await TwoFactor.ResetAsync(Actor, person, HttpContext.RequestAborted)
            ? $"Two-step sign in is off for {person.UserName}. They are signed out and can set it up again."
            : "Nothing changed.", false);
        await LoadAsync();
    }

    private void Say(string message, bool error)
    {
        _message = message;
        _error = error;
    }
}
